# Variables para `docker compose up` (orquesta postgres + backend + frontend).
# Copiar a `.env` en la raíz del repo y completar. No commitear el .env real.

# --- Postgres ---
POSTGRES_USER=fsm
POSTGRES_PASSWORD=fsm
POSTGRES_DB=fsm

# --- Backend ---
# Cualquier string largo random sirve (ej: `openssl rand -base64 32`).
JWT_SECRET=cambiame-por-un-secreto-largo-y-random
JWT_EXPIRES_IN=8h
# Password del usuario admin que crea el seed. Cambiarla tras el primer login.
SEED_ADMIN_PASSWORD=changeme123
# Credenciales de Cloudinary (fotos de OT). Opcional para probar el resto del
# sistema, pero sin esto la subida de fotos falla.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend / CORS ---
# URL pública desde la que se sirve el frontend (para CORS del backend y para
# ORIGIN de adapter-node). En local con docker compose, dejar el default.
FRONTEND_URL=http://localhost:5173
# URL pública del backend que el frontend hornea en su build (build arg, no
# se puede cambiar después sin rebuildear la imagen del frontend).
PUBLIC_API_URL=http://localhost:3000
