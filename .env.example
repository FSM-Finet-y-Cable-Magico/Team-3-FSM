# Variables para `docker compose up` (orquesta postgres + backend + frontend).
# Copiar a `.env` en la raíz del repo y completar. No commitear el .env real.

# --- Postgres ---
POSTGRES_USER=fsm
POSTGRES_PASSWORD=fsm
POSTGRES_DB=fsm

# --- Backend ---
# Cualquier string largo random sirve (ej: `openssl rand -base64 32`).
JWT_SECRET=cambiame-por-un-secreto-largo-y-random
JWT_EXPIRES_IN=8h
# Password del usuario admin (admin.finet) que crea el seed. Sin default a
# propósito: el stack no arranca hasta que pongas una. Cualquier valor sirve
# (es una base nueva y local); cambiarla tras el primer login.
SEED_ADMIN_PASSWORD=
# Credenciales de Cloudinary (fotos de OT). Opcional: sin esto, las fotos se
# guardan como data URI base64 en vez de subirse a Cloudinary — el resto del
# sistema funciona igual, solo cambia dónde queda la imagen.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend / CORS ---
# URL pública desde la que se sirve el frontend (para CORS del backend y para
# ORIGIN de adapter-node). En local con docker compose, dejar el default.
FRONTEND_URL=http://localhost:5173
# URL pública del backend que el frontend hornea en su build (build arg, no
# se puede cambiar después sin rebuildear la imagen del frontend).
PUBLIC_API_URL=http://localhost:3000
