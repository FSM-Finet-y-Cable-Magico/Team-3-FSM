# Variables para `docker compose up` (orquesta postgres + backend + frontend).
# Copiar a `.env` en la raíz del repo y completar. No commitear el .env real.

# --- Postgres ---
POSTGRES_USER=fsm
POSTGRES_PASSWORD=fsm
POSTGRES_DB=fsm

# --- Backend ---
# Cualquier string largo random sirve (ej: `openssl rand -base64 32`).
JWT_SECRET=cambiame-por-un-secreto-largo-y-random
JWT_EXPIRES_IN=8h
# Password del usuario admin (admin.finet) que crea el seed. Sin default a
# propósito: el stack no arranca hasta que pongas una. Cualquier valor sirve
# (es una base nueva y local); cambiarla tras el primer login.
SEED_ADMIN_PASSWORD=
# Cloudinary es obligatorio para subir evidencia y completar el flujo de cierre
# de OT, que exige al menos una foto. Configurar los tres valores también en local
# para probar ese flujo. Es opcional para las demás funciones.
# Sin configurar, la subida devuelve 503; no existe persistencia local en base64.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend / CORS ---
# URL pública desde la que se sirve el frontend (para CORS del backend y para
# ORIGIN de adapter-node). En local con docker compose, dejar el default.
FRONTEND_URL=http://localhost:5173
# URL pública del backend que el frontend hornea en su build (build arg, no
# se puede cambiar después sin rebuildear la imagen del frontend).
PUBLIC_API_URL=http://localhost:3000

# --- Integraciones servidor-a-servidor (/api/integraciones/*) ---
# Claves de API por grupo, formato `grupo:clave:empresas` separados por ";".
# OJO: la clave no puede contener ":" — es el separador, y una clave que lo
# traiga se registra truncada y responde 403 a todo. Se avisa al arrancar.
# ej: G1:clave-larga-aleatoria:1,2;G2:otra-clave:1;G8:otra-mas:1,2
INTEGRACION_API_KEYS=

# Llave PRIVADA con que se descifran las claves WiFi que manda el portal de G2
# (acuerdo §6.4). RSA-OAEP/SHA-256, PKCS#8 en PEM, 3072 bits.
# Los saltos de linea van como `\n` literales, porque el .env no los admite.
# Sin esta variable, POST /api/integraciones/contrasena-wifi responde 503: es
# preferible a aceptar solicitudes que despues no se van a poder descifrar.
# NO se versiona. Generar con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out wifi.pem
#   openssl pkey -in wifi.pem -pubout -out wifi.pub   # esta es la que va a G2
WIFI_LLAVE_PRIVADA_PEM=
