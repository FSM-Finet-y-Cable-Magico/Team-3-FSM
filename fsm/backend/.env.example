# Variables para correr el backend suelto (npm run start:dev), fuera de Docker.
# Para levantar todo junto con Docker, usar el .env.example de la raíz del repo.

DATABASE_URL=postgresql://fsm:fsm@localhost:5432/fsm
FRONTEND_URL=http://localhost:5173
PORT=3000

JWT_SECRET=cambiame-por-un-secreto-largo-y-random
JWT_EXPIRES_IN=8h
# Sin default a propósito: el seed aborta si no está definida (ver README).
SEED_ADMIN_PASSWORD=

# Cloudinary (fotos de OT). Opcional: sin esto, las fotos se guardan como
# data URI base64 en la base en vez de subirse a Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Monitoreo de red (SmartOLT) ---
# Fuente de datos: "mock" (payload de ejemplo, default) o "smartolt" (API real).
MONITOREO_FUENTE=mock
# Credenciales SmartOLT (solo si MONITOREO_FUENTE=smartolt). Pedir al equipo.
# La cuenta SmartOLT debe whitelistear la IP de salida del servidor.
SMARTOLT_BASE_URL=
SMARTOLT_API_TOKEN=
# Poller: ingesta periodica de lecturas. Apagado por defecto.
MONITOREO_POLL_ENABLED=false
MONITOREO_POLL_INTERVAL_MS=300000
# Sincronizacion de topologia (olt / caja_nap). Apagada hasta acordar el
# registro de ONT con los otros grupos.
MONITOREO_TOPOLOGIA_ENABLED=false

# --- Integracion con otros grupos ---
# API keys de los sistemas que consumen /api/integraciones/*.
# Formato: grupo:clave:empresas  separados por ";"
INTEGRACION_API_KEYS=
# Webhooks del cierre de OT (fan-out best-effort). Sin URL no se notifica; el
# cierre queda para reconciliacion por GET /api/integraciones/ordenes/:id/cierre.
CIERRE_WEBHOOK_G1_URL=
CIERRE_WEBHOOK_G1_KEY=
CIERRE_WEBHOOK_G8_URL=
CIERRE_WEBHOOK_G8_KEY=
